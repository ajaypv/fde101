---
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path: string) => `${basePath}${path}`;

const terms = [
	{
		name: 'Retrieval-augmented generation',
		short: 'RAG',
		description: 'Retrieve external evidence, then generate an answer grounded in that evidence.',
		category: 'Retrieval',
		href: '/glossary/retrieval-augmented-generation/',
	},
	{
		name: 'Precision@k',
		description: 'Of the top k results returned, how many are relevant?',
		category: 'Evaluation',
		href: '/glossary/precision-at-k/',
	},
	{
		name: 'Recall@k',
		description: 'Of all known relevant results, how many appeared in the top k?',
		category: 'Evaluation',
		href: '/glossary/recall-at-k/',
	},
	{
		name: 'HNSW',
		description: 'A graph-based index for fast approximate nearest-neighbor search.',
		category: 'Retrieval',
		href: '/glossary/hnsw/',
	},
	{
		name: 'Embedding',
		description: 'A numeric representation used to compare semantic similarity.',
		category: 'Retrieval',
		href: '/glossary/embedding/',
	},
	{
		name: 'Vector store',
		description: 'A system that stores embeddings and searches for nearby items.',
		category: 'Retrieval',
		href: '/glossary/vector-store/',
	},
	{
		name: 'Semantic search',
		description: 'Search by meaning instead of relying only on matching words.',
		category: 'Retrieval',
		href: '/glossary/semantic-search/',
	},
	{
		name: 'Hybrid search',
		description: 'Combine semantic and keyword retrieval, then merge their rankings.',
		category: 'Retrieval',
		href: '/glossary/hybrid-search/',
	},
	{
		name: 'Chunking',
		description: 'Split source documents into useful units for retrieval and citation.',
		category: 'Retrieval',
		href: '/rag/chunking/',
	},
	{
		name: 'Reranking',
		description: 'Rescore retrieved candidates with a more precise second-stage model.',
		category: 'Retrieval',
		href: '/glossary/reranking/',
	},
	{
		name: 'Context window',
		description: 'The token budget a model can consider during one request.',
		category: 'Models',
		href: '/glossary/context-window/',
	},
	{
		name: 'Token',
		description: 'A unit of text read or generated by a language model.',
		category: 'Models',
		href: '/glossary/token/',
	},
	{
		name: 'Prompt',
		description: 'The instructions and information supplied to a model for a task.',
		category: 'Models',
		href: '/glossary/prompt/',
	},
	{
		name: 'System prompt',
		description: 'High-priority instructions that define the model’s role and boundaries.',
		category: 'Models',
		href: '/glossary/system-prompt/',
	},
	{
		name: 'Message roles',
		description: 'System, user, assistant, and tool labels that structure a conversation.',
		category: 'Models',
		href: '/glossary/message-roles/',
	},
	{
		name: 'Groundedness',
		description: 'Whether an answer’s claims are supported by the supplied evidence.',
		category: 'Evaluation',
		href: '/glossary/groundedness/',
	},
	{
		name: 'Hallucination',
		description: 'A fluent claim that is unsupported by the evidence available to the system.',
		category: 'Models',
		href: '/glossary/hallucination/',
	},
	{
		name: 'Abstention',
		description: 'Refusing to guess when evidence or confidence is insufficient.',
		category: 'Evaluation',
		href: '/glossary/abstention/',
	},
	{
		name: 'Evaluation',
		short: 'Evals',
		description: 'Repeatable cases, scoring rules, and thresholds used to judge a system.',
		category: 'Evaluation',
		href: '/evals/',
	},
	{
		name: 'Agent',
		description: 'A model-directed loop that can choose tools and actions toward a goal.',
		category: 'Agents',
		href: '/glossary/agent/',
	},
	{
		name: 'Tool calling',
		description: 'A model requests a typed function; application code validates and executes it.',
		category: 'Agents',
		href: '/glossary/tool-calling/',
	},
	{
		name: 'Model Context Protocol',
		short: 'MCP',
		description: 'A standard way for AI applications to connect to tools and context providers.',
		category: 'Agents',
		href: '/glossary/model-context-protocol/',
	},
	{
		name: 'State',
		description: 'The shared data a graph reads and updates while a workflow runs.',
		category: 'Agents',
		href: '/glossary/state/',
	},
	{
		name: 'Checkpoint',
		description: 'A saved state snapshot that allows a workflow to resume later.',
		category: 'Agents',
		href: '/glossary/checkpoint/',
	},
	{
		name: 'Thread',
		description: 'The identity grouping checkpoints for one conversation or job.',
		category: 'Agents',
		href: '/glossary/thread/',
	},
	{
		name: 'LangChain',
		description: 'Application interfaces for models, messages, tools, retrieval, and agents.',
		category: 'Frameworks',
		href: '/langchain/',
	},
	{
		name: 'LangGraph',
		description: 'Graph orchestration for stateful, durable, and inspectable workflows.',
		category: 'Frameworks',
		href: '/langgraph/',
	},
];
---

<main class="fde-home">
	<div class="index-meta" aria-hidden="true">
		<span>Field index</span>
		<span>{terms.length} essential terms</span>
	</div>

	<nav class="term-grid" aria-label="AI field index">
		{terms.map((term, index) => (
			<a class="term-entry" href={withBase(term.href)}>
				<span class="term-number">{String(index + 1).padStart(2, '0')}</span>
				<span class="term-category">{term.category}</span>
				<strong class="term-name">{term.short ?? term.name}</strong>
				{term.short && <span class="term-long-name">{term.name}</span>}
				<p>{term.description}</p>
				<span class="term-action">Read note&nbsp; ↗</span>
			</a>
		))}
	</nav>

	<footer class="index-footer">
		<a href={withBase('/start-here/')}>Reading paths</a>
		<a href={withBase('/interview/')}>Interview questions</a>
		<a href={withBase('/field-guide/production-rag-checklist/')}>Production checklist</a>
	</footer>
</main>
